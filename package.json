{
  "name": "ai-admin",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "auth:generate": "cd apps/server && pnpm run auth:generate",
    "build": "turbo run build",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate -F @ai-admin/db --",
    "db:migrate": "turbo run db:migrate -F @ai-admin/db --",
    "db:push": "turbo run db:push -F @ai-admin/db --",
    "db:studio": "turbo run db:studio -F @ai-admin/db --",
    "dev": "turbo run dev",
    "dev:native": "turbo run dev -F native --",
    "dev:server": "turbo run dev -F server --",
    "dev:web": "turbo run dev -F web --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "fix": "ultracite fix",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-admin/config": "workspace:*",
    "@biomejs/biome": "2.5.15",
    "@types/node": "catalog:",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "ultracite": "8.0.0",
    "varlock": "catalog:"
  },
  "packageManager": "pnpm@12.15.0"
}
